pipeline {

    agent any

    environment {
        SONAR_URL = 'http://192.168.73.146:9000'

        DOCKER_IMAGE = "suyashawate/ultimate-cicd:${BUILD_NUMBER}"

        GIT_REPO_NAME = 'Jenkins-Zero-To-Hero'
        GIT_USER_NAME = 'devopsuser60'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=========================================='
                echo ' CHECKOUT'
                echo '=========================================='

                checkout scm

                sh '''
                    echo "Workspace:"
                    pwd

                    echo "Files:"
                    ls -ltr

                    echo "Java:"
                    java -version

                    echo "Maven:"
                    mvn -version

                    echo "Docker:"
                    docker --version

                    echo "Git:"
                    git --version
                '''
            }
        }

        stage('Build and Test') {
            steps {
                dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {

                    sh '''
                        echo "=========================================="
                        echo " BUILD AND TEST"
                        echo "=========================================="

                        mvn clean package
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {

                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {

                    dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {

                        sh '''
                            echo "=========================================="
                            echo " SONARQUBE ANALYSIS"
                            echo "=========================================="

                            java -version
                            mvn -version

                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.7.0.6970:sonar \
                              -Dsonar.token="$SONAR_AUTH_TOKEN" \
                              -Dsonar.host.url="$SONAR_URL"
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {

                dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {

                    sh '''
                        echo "=========================================="
                        echo " BUILD DOCKER IMAGE"
                        echo "=========================================="

                        docker --version

                        docker build \
                            -t "$DOCKER_IMAGE" \
                            .
                    '''
                }
            }
        }

        stage('Push Docker Image') {
            steps {

                script {

                    echo "=========================================="
                    echo " PUSH TO DOCKER HUB"
                    echo "=========================================="

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {

                        docker.image("${DOCKER_IMAGE}").push()
                    }
                }
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {

                withCredentials([
                    string(
                        credentialsId: 'github-cred',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "=========================================="
                        echo " UPDATE KUBERNETES MANIFEST"
                        echo "=========================================="

                        chmod +x deploy.sh

                        ./deploy.sh "$BUILD_NUMBER"
                    '''
                }
            }
        }
    }

    post {

        success {
            echo '=========================================='
            echo ' PIPELINE COMPLETED SUCCESSFULLY'
            echo " Docker Image: ${DOCKER_IMAGE}"
            echo " Build Number: ${BUILD_NUMBER}"
            echo '=========================================='
        }

        failure {
            echo '=========================================='
            echo ' PIPELINE FAILED'
            echo " Build Number: ${BUILD_NUMBER}"
            echo ' Check the failed stage logs.'
            echo '=========================================='
        }
    }
}

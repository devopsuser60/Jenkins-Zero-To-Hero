pipeline {

    agent any

    environment {
        SONAR_URL = 'http://192.168.73.146:9000'

        DOCKER_IMAGE = 'suyashawate/ultimate-cicd'

        GIT_USER_NAME = 'devopsuser60'
        GIT_REPO_NAME = 'Jenkins-Zero-To-Hero'
        MANIFEST_REPO_NAME = 'spring-boot-app-manifests'

        APP_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=========================================='
                echo ' CHECKOUT'
                echo '=========================================='

                checkout scm

                sh '''
                    set -e

                    echo "Workspace:"
                    pwd

                    echo "Files:"
                    ls -la
                '''
            }
        }

        stage('Build and Test') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        set -e

                        echo '=========================================='
                        echo ' BUILD AND TEST'
                        echo '=========================================='

                        java -version
                        mvn -version

                        mvn clean package
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {
                    dir("${APP_DIR}") {
                        sh '''
                            set -e

                            echo '=========================================='
                            echo ' SONARQUBE ANALYSIS'
                            echo '=========================================='

                            mvn \
                              org.sonarsource.scanner.maven:sonar-maven-plugin:5.5.0.6356:sonar \
                              -Dsonar.token="$SONAR_AUTH_TOKEN" \
                              -Dsonar.host.url="$SONAR_URL"
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        set -e

                        echo '=========================================='
                        echo ' BUILD DOCKER IMAGE'
                        echo '=========================================='

                        docker --version

                        docker build \
                          -t "${DOCKER_IMAGE}:${BUILD_NUMBER}" \
                          -t "${DOCKER_IMAGE}:latest" \
                          .
                    '''
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    echo '=========================================='
                    echo ' PUSH DOCKER IMAGE'
                    echo '=========================================='

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        retry(3) {
                            docker.image(
                                "${DOCKER_IMAGE}:${BUILD_NUMBER}"
                            ).push()

                            docker.image(
                                "${DOCKER_IMAGE}:latest"
                            ).push()
                        }
                    }
                }
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-cred',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        echo '=========================================='
                        echo ' UPDATE KUBERNETES MANIFEST REPO'
                        echo '=========================================='

                        # 1. Clean workspace directory & clone remote manifest repo
                        rm -rf manifest-repo
                        git clone "https://${GIT_USER_NAME}:${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${MANIFEST_REPO_NAME}.git" manifest-repo

                        cd manifest-repo

                        echo "Current image in deployment.yaml:"
                        grep 'image:' deployment.yaml || true

                        echo
                        echo "Updating image tag to BUILD_NUMBER=${BUILD_NUMBER}..."

                        # 2. Update image tag using regex replacement
                        sed -i -E \
                          "s|(${DOCKER_IMAGE}:)[^[:space:]\\"]*|\\1${BUILD_NUMBER}|g" \
                          deployment.yaml

                        echo
                        echo "New image in deployment.yaml:"
                        grep 'image:' deployment.yaml

                        echo
                        echo "Verifying image tag..."
                        grep -q "${DOCKER_IMAGE}:${BUILD_NUMBER}" deployment.yaml
                        echo "Image tag verification successful."

                        # 3. Configure Git credentials & commit changes
                        git config user.email "devopsuser60@gmail.com"
                        git config user.name "devopsuser60"

                        git add deployment.yaml

                        git commit \
                          -m "Update deployment image to version ${BUILD_NUMBER}" \
                          || echo "No manifest changes to commit"

                        echo
                        echo "Pushing manifest update to ${MANIFEST_REPO_NAME}..."

                        git push origin main
                    '''
                }
            }
        }

        stage('Argo CD') {
            steps {
                echo '=========================================='
                echo ' ARGO CD'
                echo '=========================================='

                echo 'Git manifest updated successfully in spring-boot-app-manifests.'
                echo 'Argo CD will detect the Git change and deploy to Kubernetes.'
            }
        }
    }

    post {

        success {
            echo '=========================================='
            echo ' PIPELINE COMPLETED SUCCESSFULLY'
            echo '=========================================='

            echo "Docker Image: ${DOCKER_IMAGE}:${BUILD_NUMBER}"
            echo "Latest Image: ${DOCKER_IMAGE}:latest"
        }

        failure {
            echo '=========================================='
            echo ' PIPELINE FAILED'
            echo '=========================================='

            echo "Check the failed stage above."
        }
    }
}

pipeline {

    agent any

    environment {
        SONAR_URL = 'http://192.168.73.146:9000'

        DOCKER_IMAGE = 'suyashawate/ultimate-cicd'

        GIT_USER_NAME = 'devopsuser60'
        GIT_REPO_NAME = 'Jenkins-Zero-To-Hero'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=========================================='
                echo ' CHECKOUT'
                echo '=========================================='

                checkout scm

                sh '''
                    echo "Workspace:"
                    pwd
                    echo "Files:"
                    ls -la
                '''
            }
        }

        stage('Build and Test') {
            steps {
                dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
                    sh '''
                        set -e

                        echo '=========================================='
                        echo ' BUILD AND TEST'
                        echo '=========================================='

                        java -version
                        mvn -version

                        mvn clean package
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {
                    dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
                        sh '''
                            set -e

                            echo '=========================================='
                            echo ' SONARQUBE ANALYSIS'
                            echo '=========================================='

                            mvn sonar:sonar \
                              -Dsonar.login="$SONAR_AUTH_TOKEN" \
                              -Dsonar.host.url="$SONAR_URL"
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
                    sh '''
                        set -e

                        echo '=========================================='
                        echo ' BUILD DOCKER IMAGE'
                        echo '=========================================='

                        docker --version

                        docker build \
                          -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                          -t ${DOCKER_IMAGE}:latest \
                          .
                    '''
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    echo '=========================================='
                    echo ' PUSH DOCKER IMAGE'
                    echo '=========================================='

                    def dockerImage =
                        docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}")

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        dockerImage.push()
                        docker.image("${DOCKER_IMAGE}:latest").push()
                    }
                }
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-cred',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        echo '=========================================='
                        echo ' UPDATE KUBERNETES MANIFEST'
                        echo '=========================================='

                        MANIFEST="java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml"

                        echo "Updating image tag to ${BUILD_NUMBER}"

                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" "$MANIFEST"

                        git config user.email "devopsuser60@gmail.com"
                        git config user.name "devopsuser60"

                        git add "$MANIFEST"

                        git commit \
                          -m "Update deployment image to version ${BUILD_NUMBER}" \
                          || echo "No manifest changes to commit"

                        git push \
                          "https://${GIT_USER_NAME}:${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" \
                          HEAD:main
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    set -e

                    echo '=========================================='
                    echo ' ARGO CD DEPLOYMENT'
                    echo '=========================================='

                    echo "Manifest pushed to GitHub."
                    echo "Argo CD will detect the Git change and synchronize Kubernetes."
                '''
            }
        }
    }

    post {
        success {
            echo '=========================================='
            echo ' PIPELINE COMPLETED SUCCESSFULLY'
            echo '=========================================='
        }

        failure {
            echo '=========================================='
            echo ' PIPELINE FAILED'
            echo '=========================================='
        }
    }
}

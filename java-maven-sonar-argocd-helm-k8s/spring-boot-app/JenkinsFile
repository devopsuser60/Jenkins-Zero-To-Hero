pipeline {
    agent any

    environment {
        APP_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app'
        MANIFEST_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests'
        IMAGE_NAME = 'spring-boot-web'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        set -e
                        mvn clean package -DskipTests
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir("${APP_DIR}") {
                    withSonarQubeEnv('sonarqube') {
                        sh '''
                            set -e
                            mvn sonar:sonar
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        set -e
                        docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                    '''
                }
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                dir("${MANIFEST_DIR}") {
                    sh '''
                        set -e

                        if [ ! -f deployment.yaml ]; then
                            echo "ERROR: deployment.yaml not found"
                            exit 1
                        fi

                        sed -i "s|image:.*|image: ${IMAGE_NAME}:${IMAGE_TAG}|g" deployment.yaml

                        cat deployment.yaml
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    set -e

                    kubectl apply -f ${MANIFEST_DIR}/deployment.yaml
                    kubectl apply -f ${MANIFEST_DIR}/service.yaml

                    kubectl rollout status deployment/spring-boot-web --timeout=180s

                    kubectl get pods
                    kubectl get svc
                    kubectl get deployment
                '''
            }
        }
    }

    post {
        success {
            echo 'PIPELINE COMPLETED SUCCESSFULLY'
        }

        failure {
            echo 'PIPELINE FAILED'
        }
    }
}
